{
  "opencollection": "1.0.0",
  "info": {
    "name": "Azure Service Bus Management Namespaces Topics API",
    "version": "2021-11-01"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "implicit",
      "authorizationUrl": "https://login.microsoftonline.com/common/oauth2/authorize",
      "credentials": {
        "clientId": "{{clientId}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Topics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Azure Service Bus List Topics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://management.azure.com/subscriptions/:subscriptionId/resourceGroups/:resourceGroupName/providers/Microsoft.ServiceBus/namespaces/:namespaceName/topics",
            "params": [
              {
                "name": "subscriptionId",
                "value": "",
                "type": "path",
                "description": "The Azure subscription ID."
              },
              {
                "name": "resourceGroupName",
                "value": "",
                "type": "path",
                "description": "Name of the resource group."
              },
              {
                "name": "namespaceName",
                "value": "",
                "type": "path",
                "description": "The namespace name."
              },
              {
                "name": "api-version",
                "value": "",
                "type": "query",
                "description": "Client API version."
              },
              {
                "name": "$skip",
                "value": "10",
                "type": "query"
              },
              {
                "name": "$top",
                "value": "10",
                "type": "query"
              }
            ]
          },
          "docs": "Gets all the topics in a namespace."
        },
        {
          "info": {
            "name": "Azure Service Bus Get a Topic",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://management.azure.com/subscriptions/:subscriptionId/resourceGroups/:resourceGroupName/providers/Microsoft.ServiceBus/namespaces/:namespaceName/topics/:topicName",
            "params": [
              {
                "name": "subscriptionId",
                "value": "",
                "type": "path",
                "description": "The Azure subscription ID."
              },
              {
                "name": "resourceGroupName",
                "value": "",
                "type": "path",
                "description": "Name of the resource group."
              },
              {
                "name": "namespaceName",
                "value": "",
                "type": "path",
                "description": "The namespace name."
              },
              {
                "name": "topicName",
                "value": "example_value",
                "type": "path"
              },
              {
                "name": "api-version",
                "value": "",
                "type": "query",
                "description": "Client API version."
              }
            ]
          },
          "docs": "Returns a description for the specified topic."
        },
        {
          "info": {
            "name": "Azure Service Bus Create or Update a Topic",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://management.azure.com/subscriptions/:subscriptionId/resourceGroups/:resourceGroupName/providers/Microsoft.ServiceBus/namespaces/:namespaceName/topics/:topicName",
            "params": [
              {
                "name": "subscriptionId",
                "value": "",
                "type": "path",
                "description": "The Azure subscription ID."
              },
              {
                "name": "resourceGroupName",
                "value": "",
                "type": "path",
                "description": "Name of the resource group."
              },
              {
                "name": "namespaceName",
                "value": "",
                "type": "path",
                "description": "The namespace name."
              },
              {
                "name": "topicName",
                "value": "example_value",
                "type": "path"
              },
              {
                "name": "api-version",
                "value": "",
                "type": "query",
                "description": "Client API version."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a topic in the specified namespace."
        },
        {
          "info": {
            "name": "Azure Service Bus Delete a Topic",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://management.azure.com/subscriptions/:subscriptionId/resourceGroups/:resourceGroupName/providers/Microsoft.ServiceBus/namespaces/:namespaceName/topics/:topicName",
            "params": [
              {
                "name": "subscriptionId",
                "value": "",
                "type": "path",
                "description": "The Azure subscription ID."
              },
              {
                "name": "resourceGroupName",
                "value": "",
                "type": "path",
                "description": "Name of the resource group."
              },
              {
                "name": "namespaceName",
                "value": "",
                "type": "path",
                "description": "The namespace name."
              },
              {
                "name": "topicName",
                "value": "example_value",
                "type": "path"
              },
              {
                "name": "api-version",
                "value": "",
                "type": "query",
                "description": "Client API version."
              }
            ]
          },
          "docs": "Deletes a topic from the specified namespace."
        }
      ]
    }
  ],
  "bundled": true
}