{
  "opencollection": "1.0.0",
  "info": {
    "name": "Azure Service Bus Management Namespaces API",
    "version": "2021-11-01"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "implicit",
      "authorizationUrl": "https://login.microsoftonline.com/common/oauth2/authorize",
      "credentials": {
        "clientId": "{{clientId}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Namespaces",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Azure Service Bus List All Namespaces",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://management.azure.com/subscriptions/:subscriptionId/providers/Microsoft.ServiceBus/namespaces",
            "params": [
              {
                "name": "subscriptionId",
                "value": "",
                "type": "path",
                "description": "The Azure subscription ID."
              },
              {
                "name": "api-version",
                "value": "",
                "type": "query",
                "description": "Client API version."
              }
            ]
          },
          "docs": "Gets all the available namespaces within the subscription."
        },
        {
          "info": {
            "name": "Azure Service Bus List Namespaces by Resource Group",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://management.azure.com/subscriptions/:subscriptionId/resourceGroups/:resourceGroupName/providers/Microsoft.ServiceBus/namespaces",
            "params": [
              {
                "name": "subscriptionId",
                "value": "",
                "type": "path",
                "description": "The Azure subscription ID."
              },
              {
                "name": "resourceGroupName",
                "value": "",
                "type": "path",
                "description": "Name of the resource group."
              },
              {
                "name": "api-version",
                "value": "",
                "type": "query",
                "description": "Client API version."
              }
            ]
          },
          "docs": "Gets the available namespaces within a resource group."
        },
        {
          "info": {
            "name": "Azure Service Bus Get a Namespace",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://management.azure.com/subscriptions/:subscriptionId/resourceGroups/:resourceGroupName/providers/Microsoft.ServiceBus/namespaces/:namespaceName",
            "params": [
              {
                "name": "subscriptionId",
                "value": "",
                "type": "path",
                "description": "The Azure subscription ID."
              },
              {
                "name": "resourceGroupName",
                "value": "",
                "type": "path",
                "description": "Name of the resource group."
              },
              {
                "name": "namespaceName",
                "value": "",
                "type": "path",
                "description": "The namespace name."
              },
              {
                "name": "api-version",
                "value": "",
                "type": "query",
                "description": "Client API version."
              }
            ]
          },
          "docs": "Gets a description for the specified namespace."
        },
        {
          "info": {
            "name": "Azure Service Bus Create or Update a Namespace",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://management.azure.com/subscriptions/:subscriptionId/resourceGroups/:resourceGroupName/providers/Microsoft.ServiceBus/namespaces/:namespaceName",
            "params": [
              {
                "name": "subscriptionId",
                "value": "",
                "type": "path",
                "description": "The Azure subscription ID."
              },
              {
                "name": "resourceGroupName",
                "value": "",
                "type": "path",
                "description": "Name of the resource group."
              },
              {
                "name": "namespaceName",
                "value": "",
                "type": "path",
                "description": "The namespace name."
              },
              {
                "name": "api-version",
                "value": "",
                "type": "query",
                "description": "Client API version."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates or updates a Service Bus namespace."
        },
        {
          "info": {
            "name": "Azure Service Bus Delete a Namespace",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://management.azure.com/subscriptions/:subscriptionId/resourceGroups/:resourceGroupName/providers/Microsoft.ServiceBus/namespaces/:namespaceName",
            "params": [
              {
                "name": "subscriptionId",
                "value": "",
                "type": "path",
                "description": "The Azure subscription ID."
              },
              {
                "name": "resourceGroupName",
                "value": "",
                "type": "path",
                "description": "Name of the resource group."
              },
              {
                "name": "namespaceName",
                "value": "",
                "type": "path",
                "description": "The namespace name."
              },
              {
                "name": "api-version",
                "value": "",
                "type": "query",
                "description": "Client API version."
              }
            ]
          },
          "docs": "Deletes an existing namespace."
        }
      ]
    }
  ],
  "bundled": true
}